# Copy this file to .env and fill in real values. Never share the real .env.
# No spaces around "=", no quotation marks.
HELIUS_API_KEY=
JUPITER_API_KEY=
DISCORD_WEBHOOK_URL=
RUGCHECK_API_KEY=
# Optional. Use another provider's WebSocket for the live stream (public Solana RPC: wss://api.mainnet-beta.solana.com).
# If it contains a key, keep it here, never in chat.
STREAM_WS_URL=
# Leave empty during paper trading. Only used in live mode (not built yet).
TRADER_PRIVATE_KEY=
